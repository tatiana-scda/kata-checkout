{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-4789-a012-3456789abcde",
    "name": "Kata Checkout",
    "description": "Collection for the Kata Checkout API (POST /v1/checkout).\n\nEach request sends the item catalogue, the pricing rules and the cart in one body. Rule order matters: promotions (buyGetFree, buyBulk, mealDeal) must be listed before unitPrice rules, because rules consume cart items in list order.\n\nEvery request includes tests that assert the HTTP status and, for happy paths, the exact total in pence.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Happy path",
      "item": [
        {
          "name": "01 - Unit prices only",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/v1/checkout",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"id\": \"A\", \"priceInPence\": 50 },\n    { \"id\": \"B\", \"priceInPence\": 75 }\n  ],\n  \"pricingRules\": [\n    { \"type\": \"unitPrice\", \"itemId\": \"A\" },\n    { \"type\": \"unitPrice\", \"itemId\": \"B\" }\n  ],\n  \"cart\": {\n    \"items\": [\n      { \"itemId\": \"A\", \"quantity\": 1 },\n      { \"itemId\": \"B\", \"quantity\": 2 }\n    ]\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "1 x A at 50 plus 2 x B at 75. Expected total: 200."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"total is 200\", () => pm.expect(pm.response.json().totalInPence).to.eql(200));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "02 - Bulk promotion",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/v1/checkout",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"id\": \"A\", \"priceInPence\": 50 },\n    { \"id\": \"B\", \"priceInPence\": 75 }\n  ],\n  \"pricingRules\": [\n    { \"type\": \"buyBulk\", \"itemId\": \"A\", \"bulkQuantity\": 3, \"bulkPrice\": 130 },\n    { \"type\": \"unitPrice\", \"itemId\": \"A\" },\n    { \"type\": \"unitPrice\", \"itemId\": \"B\" }\n  ],\n  \"cart\": {\n    \"items\": [\n      { \"itemId\": \"A\", \"quantity\": 3 },\n      { \"itemId\": \"B\", \"quantity\": 2 }\n    ]\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "3 x A hits the bulk price of 130, plus 2 x B at 75. Expected total: 280."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"total is 280\", () => pm.expect(pm.response.json().totalInPence).to.eql(280));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "03 - Bulk promotion with leftovers",
          "request": {
