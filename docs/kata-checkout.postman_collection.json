        {
          "name": "07 - All rule types combined",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/v1/checkout",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"id\": \"A\", \"priceInPence\": 50 },\n    { \"id\": \"B\", \"priceInPence\": 75 },\n    { \"id\": \"C\", \"priceInPence\": 25 },\n    { \"id\": \"D\", \"priceInPence\": 150 },\n    { \"id\": \"E\", \"priceInPence\": 200 }\n  ],\n  \"pricingRules\": [\n    { \"type\": \"mealDeal\", \"dealItemIds\": [\"A\", \"B\"], \"dealPrice\": 100 },\n    { \"type\": \"mealDeal\", \"dealItemIds\": [\"C\", \"D\"], \"dealPrice\": 150 },\n    { \"type\": \"buyBulk\", \"itemId\": \"A\", \"bulkQuantity\": 3, \"bulkPrice\": 130 },\n    { \"type\": \"buyBulk\", \"itemId\": \"B\", \"bulkQuantity\": 2, \"bulkPrice\": 120 },\n    { \"type\": \"buyGetFree\", \"itemId\": \"D\", \"buyQuantity\": 2 },\n    { \"type\": \"buyGetFree\", \"itemId\": \"E\", \"buyQuantity\": 2 },\n    { \"type\": \"unitPrice\", \"itemId\": \"A\" },\n    { \"type\": \"unitPrice\", \"itemId\": \"B\" },\n    { \"type\": \"unitPrice\", \"itemId\": \"C\" },\n    { \"type\": \"unitPrice\", \"itemId\": \"D\" },\n    { \"type\": \"unitPrice\", \"itemId\": \"E\" }\n  ],\n  \"cart\": {\n    \"items\": [\n      { \"itemId\": \"A\", \"quantity\": 3 },\n      { \"itemId\": \"B\", \"quantity\": 2 },\n      { \"itemId\": \"C\", \"quantity\": 4 },\n      { \"itemId\": \"D\", \"quantity\": 3 },\n      { \"itemId\": \"E\", \"quantity\": 3 }\n    ]\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Two meal deals (2 x 100, 3 x 150), buy-get-free on E (2 x 200), and leftovers A (50) and C (25) at unit price. Expected total: 1125."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"total is 1125\", () => pm.expect(pm.response.json().totalInPence).to.eql(1125));"
                ]
              }
            }
          ],
          "response": []
        },
