            "url": "{{baseUrl}}/v1/checkout",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"id\": \"A\", \"priceInPence\": 50 }\n  ],\n  \"pricingRules\": [\n    { \"type\": \"buyBulk\", \"itemId\": \"A\", \"bulkQuantity\": 3, \"bulkPrice\": 130 },\n    { \"type\": \"unitPrice\", \"itemId\": \"A\" }\n  ],\n  \"cart\": {\n    \"items\": [\n      { \"itemId\": \"A\", \"quantity\": 5 }\n    ]\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "5 x A: one bulk pack of 3 at 130, the 2 leftovers fall through to the unit price at 50 each. Expected total: 230."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"total is 230\", () => pm.expect(pm.response.json().totalInPence).to.eql(230));"
                ]
