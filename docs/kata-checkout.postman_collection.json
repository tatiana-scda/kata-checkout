              "options": { "raw": { "language": "json" } }
            },
            "description": "One of each deal item: the meal deal (100) applies and nothing is left for the unit rules. Expected total: 100."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"total is 100\", () => pm.expect(pm.response.json().totalInPence).to.eql(100));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "06 - Meal deal with leftovers",
          "request": {
            "method": "POST",
