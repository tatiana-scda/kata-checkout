              "options": { "raw": { "language": "json" } }
            },
            "description": "3 x D with buy-2-get-1-free: pays for 2 of 3. Expected total: 300."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"total is 300\", () => pm.expect(pm.response.json().totalInPence).to.eql(300));"
                ]
              }
            }
          ],
          "response": []
